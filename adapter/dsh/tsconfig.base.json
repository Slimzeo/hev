{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "../../../deepseek-harness/node_modules/@types"],
    "paths": {
      "@deepseek-ai/cordis": ["../../../deepseek-harness/vendor/cordis/src"],
      "@deepseek-ai/cosmokit": ["../../../deepseek-harness/vendor/cosmokit/src"],
      "@deepseek-ai/schemastery": ["../../../deepseek-harness/vendor/schemastery/src"],
      "@deepseek-ai/dsh-agent": ["../../../deepseek-harness/packages/core/agent/src"],
      "@deepseek-ai/dsh-agent/*": ["../../../deepseek-harness/packages/core/agent/src/*"],
      "@deepseek-ai/dsh-brand": ["../../../deepseek-harness/packages/util/brand/src"],
      "@deepseek-ai/dsh-commands": ["../../../deepseek-harness/packages/interaction/commands/src"],
      "@deepseek-ai/dsh-commands/*": ["../../../deepseek-harness/packages/interaction/commands/src/*"],
      "@deepseek-ai/dsh-llm": ["../../../deepseek-harness/packages/llm/llm/src"],
      "@deepseek-ai/dsh-llm/*": ["../../../deepseek-harness/packages/llm/llm/src/*"],
      "@deepseek-ai/dsh-native-command": ["../../../deepseek-harness/packages/util/native-command/src"],
      "@deepseek-ai/dsh-scope": ["../../../deepseek-harness/packages/core/scope/src"],
      "@deepseek-ai/dsh-scope/*": ["../../../deepseek-harness/packages/core/scope/src/*"],
      "@deepseek-ai/dsh-session": ["../../../deepseek-harness/packages/core/session/src"],
      "@deepseek-ai/dsh-session/*": ["../../../deepseek-harness/packages/core/session/src/*"],
      "@deepseek-ai/dsh-skill": ["../../../deepseek-harness/packages/skill/skill/src"],
      "@deepseek-ai/dsh-skill/*": ["../../../deepseek-harness/packages/skill/skill/src/*"],
      "@deepseek-ai/dsh-system-prompt": ["../../../deepseek-harness/packages/core/system-prompt/src"],
      "@deepseek-ai/dsh-system-prompt/*": ["../../../deepseek-harness/packages/core/system-prompt/src/*"],
      "@deepseek-ai/dsh-tools": ["../../../deepseek-harness/packages/core/tools/src"],
      "@deepseek-ai/dsh-tools/*": ["../../../deepseek-harness/packages/core/tools/src/*"],
      "@deepseek-ai/dsh-typert-protocol": ["../../../deepseek-harness/packages/typert/protocol/src"],
      "@deepseek-ai/dsh-typert-protocol/*": ["../../../deepseek-harness/packages/typert/protocol/src/*"],
      "@owariband/hev-dsh-plugin/hev-runtime": ["./src/hev-runtime/index.ts"],
      "@owariband/hev-dsh-plugin/hev-skill-registry": ["./src/hev-skill-registry/index.ts"],
      "@owariband/hev-dsh-plugin/hev-tool": ["./src/hev-tool/index.ts"]
    }
  }
}
