{
  "name": "@hev/dsh-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b packages/runtime packages/skill && pnpm --dir packages/runtime exec tsdown lib/types/index.js --out-dir lib --format esm --platform node --target es2024 --no-clean --no-fixed-extension && pnpm --dir packages/skill exec tsdown lib/types/index.js --out-dir lib --format esm --platform node --target es2024 --no-clean --no-fixed-extension",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config packages/runtime/vitest.config.ts --configLoader native"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@hev/dsh-runtime": "workspace:^",
    "@hev/dsh-skill": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-app-boot": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.8",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
